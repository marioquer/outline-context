{
  "name": "context-tree-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "A semantic context switcher for long-running LLM conversations.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --filter @context-tree/demo dev",
    "build": "pnpm --filter @context-tree/demo build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @context-tree/demo typecheck",
    "example": "tsx examples/basic/index.ts",
    "bench": "tsx benchmarks/runners/run-all.ts",
    "bench:routing": "tsx benchmarks/runners/routing.ts",
    "bench:context": "tsx benchmarks/runners/context.ts",
    "bench:switching": "tsx benchmarks/runners/switching.ts",
    "bench:llm": "tsx benchmarks/runners/llm-answers.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
