# Copy to .env.local (git-ignored). Everything is optional: without keys the
# demo, tests and deterministic benchmarks run fully local.

# Jev (typesafe-ai/jev on the Vercel AI Gateway): real routing in the demo,
# `pnpm jev:check` and `pnpm bench:jev`.
AI_GATEWAY_API_KEY=
JEV_MODEL=typesafe-ai/jev
# Pin the local reference backend even when a key is present.
JEV_FORCE_LOCAL=false
# Gateway requests per minute; typing-time previews are paced to stay under it.
JEV_RATE_LIMIT=30

# Claude: live replies in the demo and `pnpm bench:llm`.
ANTHROPIC_API_KEY=
# Model for live demo replies, and the effort level (low keeps replies snappy).
DEMO_MODEL=claude-opus-5
DEMO_EFFORT=low
# Model for `pnpm bench:llm` (same model for every strategy).
BENCH_MODEL=claude-opus-5
